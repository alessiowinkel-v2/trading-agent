# Local-only .env template. Copy to .env and fill in for local testing (scripts/selftest.sh).
# CLOUD ROUTINES MUST NOT USE A .ENV FILE - credentials come from the cloud
# environment (environment variables, or network secrets for the API keys).
# The presence of .env also marks a run as LOCAL for preflight.sh.

# Alpaca (PAPER: paper-api.alpaca.markets; LIVE: api.alpaca.markets - Phase 2 only)
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_DATA_FEED=iex
ALPACA_API_KEY=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# ALPACA_AUTH=proxy               # cloud only: keys injected as network secrets instead

# Perplexity (news, catalysts, earnings dates - never prices)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar
# PERPLEXITY_AUTH=proxy           # cloud only: key injected as a network secret

# Alerts: Discord or Slack incoming webhook
NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# NOTIFY_MENTION=<@your_discord_user_id>

# Phase 2 (live) only - never set these for paper
# LIVE_TRADING_CONFIRMED=yes
# MAX_LIVE_EQUITY=3000

# Optional limits
# MAX_ORDER_QTY=25

# Test-only (refused by preflight in the cloud)
# ALPACA_DRY_RUN=1
# PREFLIGHT_FORCE_EXIT=30

# News sleeve (GitHub Actions secrets, NOT needed locally): ALPACA_API_KEY, ALPACA_SECRET_KEY,
# ANTHROPIC_API_KEY (classifier), NOTIFY_WEBHOOK_URL; repository variable CLASSIFIER_MODEL (default claude-sonnet-5-5).
# Local scanner runs use the Alpaca keys above. ANTHROPIC_API_KEY=... enables scripts/newsclassify.py locally.
